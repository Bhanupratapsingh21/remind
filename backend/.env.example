# Server Configuration
# Set NODE_ENV=production on the live host: it enables secure cookies, webhook auth and the startup config check
NODE_ENV=development
PORT=5000
# Exact frontend origin (used for CORS). Production example: https://yourdomain.com
CLIENT_URL=http://localhost:3001

# MongoDB Connection String (MongoDB Atlas with replica set)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/remind?authSource=admin&retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Brevo SMTP Configuration for Email OTP Verification
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Remind OTP <support@yourdomain.com>"
# Brevo API key (Brevo > SMTP & API > API Keys, starts with xkeysib-). When set, email is sent over
# HTTPS instead of SMTP. Use it on hosts that block SMTP ports (Render).
BREVO_API_KEY=

# Redis (BullMQ). REQUIRED: without it no reminder is ever scheduled or called.
# Use an always-on Redis (not pay-per-command). TLS URLs start with rediss://
# Local: docker run -d -p 6379:6379 redis:7
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Vapi voice AI
VAPI_API_KEY=your_vapi_private_api_key
# Phone number ID from the Vapi dashboard. For Indian calling, import the Vobiz DID via a BYO SIP trunk credential and use that number's ID
VAPI_PHONE_NUMBER_ID=
# Optional: use a dashboard assistant instead of the inline assistant defined in code (leave empty to use the code version)
VAPI_ASSISTANT_ID=
VAPI_BASE_URL=https://api.vapi.ai
# "true" logs calls instead of placing them (also on when VAPI_API_KEY is empty)
VAPI_MOCK_CALLS=true
# Shared secret Vapi sends as x-vapi-secret on webhooks. Required in production. Generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# Public base URL Vapi uses to reach /api/webhooks/vapi (ngrok URL locally, real domain in prod)
WEBHOOK_BASE_URL=https://your-public-backend-url
APP_TIMEZONE=Asia/Kolkata

# Vobiz telephony (SIP trunk is configured in the Vobiz and Vapi dashboards; these are reserved for CDR reconciliation)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# Max outbound calls per user per rolling 24 hours (phone numbers are not verified yet)
MAX_CALLS_PER_USER_PER_DAY=20

# Dodo Payments (Basic ₹199 / Pro ₹499 monthly). Optional: without these, billing routes answer 503.
# Developer > API Keys. test keys work only with DODO_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
# Developer > Webhooks > add endpoint https://<backend>/api/webhooks/dodo, copy the signing secret (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
# Products > the two monthly subscription products (pdt_...)
DODO_PRODUCT_BASIC=
DODO_PRODUCT_PRO=

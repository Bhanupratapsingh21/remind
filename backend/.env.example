# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3001

# MongoDB Connection String (MongoDB Atlas with replica set)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/remind?authSource=admin&retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Brevo SMTP Configuration for Email OTP Verification
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Remind OTP <support@yourdomain.com>"

# Redis (BullMQ). Either REDIS_URL or host/port/password
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Vapi voice AI
VAPI_API_KEY=your_vapi_private_api_key
# Phone number ID from the Vapi dashboard. For Indian calling, import the Vobiz DID via a BYO SIP trunk credential and use that number's ID
VAPI_PHONE_NUMBER_ID=
# Optional: use a dashboard assistant instead of the inline assistant defined in code (leave empty to use the code version)
VAPI_ASSISTANT_ID=
VAPI_BASE_URL=https://api.vapi.ai
# "true" logs calls instead of placing them (also on when VAPI_API_KEY is empty)
VAPI_MOCK_CALLS=true
# Shared secret Vapi sends as x-vapi-secret on webhooks. Required in production. Generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# Public base URL Vapi uses to reach /api/webhooks/vapi (ngrok URL locally, real domain in prod)
WEBHOOK_BASE_URL=https://your-public-backend-url
APP_TIMEZONE=Asia/Kolkata

# Vobiz telephony (SIP trunk is configured in the Vobiz and Vapi dashboards; these are reserved for CDR reconciliation)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
